{
    "stop_on_error": false,
    "error_notification": {
        "enabled": true,
        "to": ["${SENDER_EMAIL}"],
        "subject_template": "[Agent ERROR] {error_count} task(s) failed in run {run_id}"
    },
    "tasks": [
        {
            "name": "Send Daily Sales Report Email",
            "type": "send_email",
            "parameters": {
                "recipients": {
                    "to": ["${TEST_RECIPIENT_EMAIL}"],
                    "cc": ["${SENDER_EMAIL}"]
                },
                "subject_template": "Daily Sales Report - {report_date}",
                "body_template": "Dear Team,\n\nPlease find the latest sales report ({report_name}) for {report_date} attached.\nTotal sales: ${sales_figure:,.2f}. Total active customers: {total_customers}.\n\nBest regards,\nAutomated Agent",
                "attachments": [
                    {"path": "{attachment_path_1}", "required": true},
                    {"path": "{attachment_path_2}", "required": false}
                ],
                "is_html": false
            },
            "output_context_key": "daily_report_email"
        },
        {
            "name": "Send HTML Summary Email",
            "type": "send_email",
            "parameters": {
                "recipients": {
                    "to": ["${TEST_RECIPIENT_EMAIL}"],
                    "bcc": ["${SENDER_EMAIL}"]
                },
                "subject_template": "[HTML] {report_name} - {report_date}",
                "body_template": "<html><body style=\"font-family:Arial,sans-serif\"><h2>{report_name}</h2><p>Report date: <b>{report_date}</b></p><table border=\"1\" cellpadding=\"6\" style=\"border-collapse:collapse\"><tr><th>Metric</th><th>Value</th></tr><tr><td>Total sales</td><td>${sales_figure:,.2f}</td></tr><tr><td>Active customers</td><td>{total_customers}</td></tr></table><p>Attachments sent earlier: {daily_report_email[attachments]}</p><p><i>Sent by the Communication Agent (run {run_id}).</i></p></body></html>",
                "attachments": [
                    {"path": "{attachment_path_2}", "only_if_context": "daily_report_email"}
                ],
                "is_html": true
            },
            "output_context_key": "html_summary_email"
        },
        {
            "name": "Send Sales Alert SMS",
            "type": "send_sms",
            "parameters": {
                "phone_numbers": ["${TEST_SMS_PHONE_NUMBER}"],
                "message_template": "Sales {report_date}: ${sales_figure:,.2f}, {total_customers} customers. Report emailed.",
                "carrier_name": "${TEST_SMS_CARRIER}"
            },
            "output_context_key": "sales_sms"
        },
        {
            "name": "Simulate Incoming Request Email (to self)",
            "type": "send_email",
            "parameters": {
                "recipients": {
                    "to": ["${SENDER_EMAIL}"]
                },
                "subject_template": "Data Request for {report_date} - Urgent [run {run_id}]",
                "body_template": "Hello Agent,\n\nWe need the latest data for {report_date}. Please process urgently. This email includes attachments.\n\nThank you,\nClient Team\n\n\nThis is an urgent request for new data processing.",
                "attachments": [
                    "data/reports/sales_report.pdf",
                    "data/reports/summary_data.xlsx"
                ],
                "is_html": false
            },
            "output_context_key": "simulated_email_sent"
        },
        {
            "name": "Process Incoming Data Requests",
            "type": "process_inbox",
            "parameters": {
                "mailbox": "INBOX",
                "search_criteria": {
                    "status": "ALL",
                    "from_sender": "${SENDER_EMAIL}",
                    "subject_contains": ["Data Request", "run {run_id}"]
                },
                "wait_for_email_seconds": 60,
                "poll_interval_seconds": 10,
                "max_emails": 10,
                "rules": [
                    {
                        "name": "Save PDF attachments of requests from self",
                        "if": {
                            "from_sender_contains": "${SENDER_EMAIL}",
                            "subject_contains": "Request",
                            "has_attachments": true
                        },
                        "then": {
                            "download_attachments_to": "data/incoming_attachments",
                            "attachment_extensions": [".pdf"],
                            "rename_template": "{report_date}_uid{uid}_{filename}",
                            "mark_as_read": true
                        }
                    },
                    {
                        "name": "SMS alert for urgent emails",
                        "if": {
                            "body_contains": "urgent"
                        },
                        "then": {
                            "send_sms_alert": true,
                            "alert_phone_numbers": ["${TEST_SMS_PHONE_NUMBER}"],
                            "alert_carrier": "${TEST_SMS_CARRIER}",
                            "alert_message_template": "URGENT request from {sender_address}. Files saved: {downloaded_files}"
                        }
                    },
                    {
                        "name": "Auto-reply to new data processing requests",
                        "if": {
                            "body_contains": "new data processing"
                        },
                        "then": {
                            "reply_with_template": "Agent received your request '{subject}' ({attachment_count} attachment(s)). We are now processing the new data. You will receive an update shortly.",
                            "reply_subject_template": "Re: {subject} - Received & Processing"
                        }
                    }
                ]
            },
            "output_context_key": "processed_inbox_results"
        }
    ]
}
